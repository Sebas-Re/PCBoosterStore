@model Paginacion
@if (Model.Total > 1)
{
    Dictionary<string, string> Ruta(int pagina) => new(Model.Ruta) { [Model.Parametro] = pagina.ToString() };
    <nav class="mt-3" aria-label="Páginas">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.Actual == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="@Model.Pagina" asp-all-route-data="Ruta(Model.Actual - 1)" aria-label="Anterior">&laquo;</a>
            </li>
            @for (int i = 1; i <= Model.Total; i++)
            {
                <li class="page-item @(i == Model.Actual ? "active" : "")">
                    <a class="page-link" asp-page="@Model.Pagina" asp-all-route-data="Ruta(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.Actual == Model.Total ? "disabled" : "")">
                <a class="page-link" asp-page="@Model.Pagina" asp-all-route-data="Ruta(Model.Actual + 1)" aria-label="Siguiente">&raquo;</a>
            </li>
        </ul>
    </nav>
}
