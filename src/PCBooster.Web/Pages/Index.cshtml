@page
@model IndexModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center portada">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="text-center mb-4">
            <div class="marca"><i class="bi bi-cpu-fill text-primary"></i> PC Booster Store</div>
            <p class="text-body-secondary mb-0">Las piezas para potenciar tu PC</p>
        </div>
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h5 mb-3">Iniciar sesión</h1>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Usuario</label>
                        <input asp-for="Nombre" class="form-control" autocomplete="username" required />
                        <span asp-validation-for="Nombre" class="validador"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Contraseña" class="form-label">Contraseña</label>
                        <input asp-for="Contraseña" class="form-control" autocomplete="current-password" required />
                        <span asp-validation-for="Contraseña" class="validador"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" id="btnIngresar">Ingresar</button>
                </form>
            </div>
            <div class="card-footer bg-white text-center py-3">
                ¿No tenés cuenta? <a asp-page="/Cuenta/Registro">Registrate</a>
            </div>
        </div>
        <p class="text-center text-body-secondary small mt-3 mb-0">
            Para probar: <code>Nom1</code> / <code>ctr1</code> (cliente) o <code>admAmador</code> / <code>admpsw2</code> (admin)
        </p>
    </div>
</div>
