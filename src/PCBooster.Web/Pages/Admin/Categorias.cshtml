@page
@model PCBooster.Web.Pages.Admin.CategoriasModel
@{
    ViewData["Title"] = "Categorías";
}

<h1 class="h3 mb-3">Categorías</h1>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body table-responsive">
                <table class="table mb-0" id="categorias">
                    <thead><tr><th>ID</th><th>Descripción</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (Categoria categoria in Model.Categorias)
                        {
                            string formulario = "categoria-" + categoria.Id;
                            <tr>
                                <td>@categoria.Id</td>
                                <td><input form="@formulario" name="descripcion" value="@categoria.Descripcion" class="form-control form-control-sm" maxlength="30" required aria-label="Descripción" /></td>
                                <td>
                                    <select form="@formulario" name="activa" class="form-select form-select-sm" aria-label="Estado">
                                        <option value="true" selected="@categoria.Activa">Activa</option>
                                        <option value="false" selected="@(!categoria.Activa)">Inactiva</option>
                                    </select>
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Guardar" asp-route-id="@categoria.Id" id="@formulario">
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Guardar"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="small text-body-secondary mt-3 mb-0">Una categoría inactiva oculta todos sus artículos del catálogo.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-3"><i class="bi bi-plus-lg"></i> Nueva categoría</h2>
                <form method="post" asp-page-handler="Agregar" class="d-flex gap-2">
                    <input name="descripcion" class="form-control" maxlength="30" placeholder="Ej: Monitores" required aria-label="Descripción" />
                    <button type="submit" class="btn btn-primary" id="btnAgregarCategoria">Agregar</button>
                </form>
            </div>
        </div>
    </div>
</div>
