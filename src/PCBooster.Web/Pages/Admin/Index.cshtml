@page
@model PCBooster.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Panel";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Hola, @User.Identity?.Name</h1>
        <p class="text-body-secondary mb-0">Así viene la tienda en los últimos 30 días</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Reportes"><i class="bi bi-graph-up"></i> Ver reportes</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4" id="indicadores">
    @foreach (Indicador indicador in Model.Indicadores)
    {
        <partial name="_Indicador" model="indicador" />
    }
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">Ingresos y pedidos por mes</h2>
                <div class="grafico"><canvas aria-label="Ingresos y pedidos por mes" role="img" data-grafico="@Model.GraficoMeses"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">Ingresos por categoría <span class="text-body-secondary fw-normal">(6 meses)</span></h2>
                <div class="grafico"><canvas aria-label="Ingresos por categoría" role="img" data-grafico="@Model.GraficoCategorias"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">Clientes nuevos por mes</h2>
                <div class="grafico grafico-chico"><canvas aria-label="Clientes nuevos por mes" role="img" data-grafico="@Model.GraficoClientes"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 mb-0">Stock bajo <span class="text-body-secondary fw-normal">(menos de @IndexModel.UmbralStock u.)</span></h2>
                    <a class="small" asp-page="/Admin/Articulos/Index">Gestionar</a>
                </div>
                @if (Model.StockBajo.Count == 0)
                {
                    <span class="text-body-secondary">Todos los artículos activos tienen stock suficiente.</span>
                }
                <ul class="list-group list-group-flush" id="stockBajo">
                    @foreach (Articulo articulo in Model.StockBajo)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><span class="text-body-secondary small me-2">@articulo.Codigo</span>@articulo.Descripcion</span>
                            <span class="badge @(articulo.Stock == 0 ? "text-bg-danger" : "text-bg-warning")">@articulo.Stock u.</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
